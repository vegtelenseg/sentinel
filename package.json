{
  "name": "@vegtelenseg/sentinel",
  "version": "0.3.0",
  "description": "TypeScript-first, domain-driven authorization engine for modern SaaS apps",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./middleware/express": {
      "types": "./dist/middleware/express.d.ts",
      "import": "./dist/middleware/express.js"
    },
    "./middleware/fastify": {
      "types": "./dist/middleware/fastify.d.ts",
      "import": "./dist/middleware/fastify.js"
    },
    "./middleware/nestjs": {
      "types": "./dist/middleware/nestjs.d.ts",
      "import": "./dist/middleware/nestjs.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "benchmark": "tsx benchmarks/run.ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "authorization",
    "rbac",
    "abac",
    "access-control",
    "permissions",
    "multitenancy",
    "typescript",
    "saas",
    "policy-engine"
  ],
  "author": "siya",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vegtelenseg/sentinel.git"
  },
  "homepage": "https://github.com/vegtelenseg/sentinel#readme",
  "bugs": {
    "url": "https://github.com/vegtelenseg/sentinel/issues"
  },
  "sideEffects": false,
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^3.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=18"
  }
}
